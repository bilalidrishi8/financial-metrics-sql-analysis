-- 1. Calculate the total revenue generated by each company.
SELECT * FROM financial_dataset

SELECT company_id,
ROUND(SUM(revenue), 2) AS total_revenue
FROM financial_dataset
GROUP BY company_id
ORDER BY total_revenue DESC

-- 2. Find the top 10 companies with the highest net income.
SELECT * FROM financial_dataset

SELECT company_id,
ROUND(SUM(net_income), 2) AS highest_net_income
FROM financial_dataset
GROUP BY company_id
ORDER BY highest_net_income DESC
LIMIT 10;

-- 3. Calculate the average operating income for each year.
SELECT * FROM financial_dataset

SELECT company_id, year,
ROUND(AVG(operating_income), 2) AS average_operating_income
FROM financial_dataset
GROUP BY company_id, year
ORDER BY average_operating_income DESC
LIMIT 10;

-- 4. Which companies have a debt-to-equity ratio greater than 2?
SELECT * FROM financial_dataset

SELECT
    company_id,
    year,
    quarter,
    debt_to_equity
FROM financial_dataset
WHERE debt_to_equity > 2
ORDER BY debt_to_equity DESC;

-- 5. Find the company with the highest Return on Equity (ROE).
SELECT * FROM financial_dataset

SELECT
    company_id,
    year,
    quarter,
	ROUND(SUM(equity), 2) AS Highest_Return_Equity
FROM financial_dataset
GROUP BY company_id, year, quarter
ORDER BY Highest_Return_Equity DESC;

-- 6. Calculate the Year-over-Year (YoY) revenue growth for each company.
SELECT * FROM financial_dataset

WITH yearly_revenue AS (
    SELECT
        company_id,
        year,
        SUM(revenue) AS total_revenue
    FROM financial_dataset
    GROUP BY company_id, year
	)
SELECT
    company_id,
    year,
    total_revenue,
    LAG(total_revenue) OVER (
        PARTITION BY company_id
        ORDER BY year
    ) AS previous_year_revenue,
    ROUND(
        (
            (total_revenue - LAG(total_revenue) OVER (
                PARTITION BY company_id
                ORDER BY year
            ))
            /
            LAG(total_revenue) OVER (
                PARTITION BY company_id
                ORDER BY year
            )
        ) * 100,
        2
    ) AS yoy_growth_percent
FROM yearly_revenue
ORDER BY company_id, year;

-- 7. Calculate the Quarter-over-Quarter (QoQ) net income growth.
SELECT * FROM financial_dataset

SELECT
    company_id,
    year,
    quarter,
    debt_to_equity
FROM financial_dataset
WHERE debt_to_equity > 2
ORDER BY debt_to_equity DESC;

-- 8. Rank companies by revenue within each year.
SELECT * FROM financial_dataset

SELECT
    company_id,
    year,
    revenue,
    RANK() OVER(
        PARTITION BY year
        ORDER BY revenue DESC
    ) AS revenue_rank
FROM financial_dataset;

-- 9. Find the top-performing company in each sector based on net income.
SELECT * FROM financial_dataset

SELECT *
FROM (
    SELECT
        company_id,
        net_income,
        ROW_NUMBER() OVER(
            PARTITION BY company_id
            ORDER BY net_income DESC
        ) AS rn
    FROM financial_dataset
) t
WHERE rn = 1;

