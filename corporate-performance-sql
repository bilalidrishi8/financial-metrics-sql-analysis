-- 12. Detect companies with unusually high expenses using the average and standard deviation.
SELECT * FROM financial_dataset

SELECT
    company_id,
    expenses
FROM financial_dataset
WHERE expenses >
(
    SELECT AVG(expenses) + STDDEV(expenses)
    FROM financial_dataset
);

-- 13. Find companies flagged for fraud and compare their average net income with non-fraud companies.
SELECT * FROM financial_dataset

SELECT
    fraud_flag,
    ROUND(AVG(net_income),2) AS average_net_income
FROM financial_dataset
GROUP BY fraud_flag
ORDER BY average_net_income;

-- 14. Calculate a running total of revenue for each company over time.
SELECT * FROM financial_dataset

SELECT
    company_id,
    year,
    revenue,
    SUM(revenue) OVER(
        PARTITION BY company_id
        ORDER BY year
    ) AS running_total
FROM financial_dataset;


--15. Find the Top 3 Companies by Net Income in Each Year
SELECT * FROM financial_dataset

SELECT *
FROM (
    SELECT
        company_id,
        year,
        net_income,
        DENSE_RANK() OVER (
            PARTITION BY year
            ORDER BY net_income DESC
        ) AS rank_no
    FROM financial_dataset
) t
WHERE rank_no <= 3
ORDER BY year, rank_no;

