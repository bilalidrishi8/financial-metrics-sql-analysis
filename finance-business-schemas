CREATE TABLE financial_dataset (
    year INT,
    quarter INT,
    company_id VARCHAR(30),
    revenue NUMERIC(18,2),
    expenses NUMERIC(18,2),
    operating_income NUMERIC(18,2),
    net_income NUMERIC(18,2),
    assets NUMERIC(18,2),
    liabilities NUMERIC(18,2),
    equity NUMERIC(18,2),
    cash_flow NUMERIC(18,2),
    eps NUMERIC(10,2),
    roe NUMERIC(10,4),
    roa NUMERIC(10,4),
    debt_to_equity NUMERIC(10,4),
    stock_price NUMERIC(12,2),
    volume_traded BIGINT,
    news_sentiment_score NUMERIC(10,4),
    social_media_buzz INT,
    sector_trend_index NUMERIC(10,4),
    global_economic_score NUMERIC(10,4),
    inflation_rate NUMERIC(10,4),
    exchange_rate NUMERIC(10,4),
    interest_rate NUMERIC(10,4),
    audit_flag BOOLEAN,
    fraud_flag BOOLEAN,
    market_shock_flag BOOLEAN,
    policy_change_flag BOOLEAN,
    target_revenue_next_qtr NUMERIC(18,2),
    target_anomaly_class INT
);

